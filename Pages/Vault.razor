@page "/vault"
@using CryptoVault.Client.DTOs
@using CryptoVault.Client.Services
@inject ApiService ApiService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<div class="vault-container">
    <div class="vault-header d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="m-0">🔒 Mi Bóveda Criptográfica</h2>
            <small class="text-muted">Protección Zero-Trust respaldada por AES-256-GCM</small>
        </div>
        <div>
            <!-- BOTÓN DE DISPONIBILIDAD (G1 CUN) -->
            <button class="btn btn-outline-info btn-sm me-2" @onclick="ExportEncryptedBackup" disabled="@(vaultItems.Count == 0)">
                💾 Exportar Respaldo Cifrado (Disponibilidad)
            </button>
            <button class="btn btn-outline-light btn-sm" @onclick="Logout">Cerrar Sesión</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @alertMessage
            <button type="button" class="btn-close" @onclick="() => alertMessage = string.Empty"></button>
        </div>
    }

    <!-- Formulario de Registro de Secretos -->
    <div class="vault-card mb-4">
        <h4>Agregar Nuevo Secreto a la Bóveda</h4>
        <EditForm Model="newItem" OnValidSubmit="HandleCreateItem">
            <div class="row g-3 mt-1">
                <div class="col-md-4">
                    <label class="form-label">Título / Servicio:</label>
                    <InputText @bind-Value="newItem.Title" class="form-control" placeholder="Ej: Correo Institucional CUN" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Usuario / Email:</label>
                    <InputText @bind-Value="newItem.Username" class="form-control" placeholder="estudiante@cun.edu.co" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Contraseña en Claro:</label>
                    <InputText @bind-Value="newItem.Password" type="password" class="form-control" placeholder="********" />
                </div>
            </div>
            <div class="mt-3 text-end">
                <button type="submit" class="btn btn-success" disabled="@isSaving">
                    @(isSaving ? "Cifrando y Guardando..." : "Cifrar & Guardar")
                </button>
            </div>
        </EditForm>
    </div>

    <!-- Tabla de Credenciales Protegidas -->
    <div class="vault-card">
        <h4>Credenciales Protegidas</h4>
        @if (isLoading)
        {
            <p><em>Cargando elementos de la bóveda...</em></p>
        }
        else if (vaultItems.Count == 0)
        {
            <p class="text-muted">No tienes credenciales registradas aún en tu bóveda.</p>
        }
        else
        {
            <table class="vault-table table table-striped table-hover mt-3">
                <thead>
                    <tr>
                        <th>Servicio / Título</th>
                        <th>Usuario</th>
                        <th>Fecha de Creación</th>
                        <th>Acción / Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in vaultItems)
                    {
                        <tr>
                            <td><strong>@item.Title</strong></td>
                            <td>@item.Username</td>
                            <td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (decryptedSecrets.ContainsKey(item.Id))
                                {
                                    <span class="decrypted-badge bg-success text-white p-1 rounded">
                                        🔑 @decryptedSecrets[item.Id]
                                    </span>
                                }
                                else
                                {
                                    <button class="btn btn-outline-warning btn-sm" @onclick="() => DecryptItem(item.Id)">
                                        🔓 Descifrar AES-256
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private List<VaultItemResponseDto> vaultItems = new List<VaultItemResponseDto>();
    private CreateVaultItemDto newItem = new CreateVaultItemDto();
    private Dictionary<Guid, string> decryptedSecrets = new Dictionary<Guid, string>();
    
    private bool isLoading = true;
    private bool isSaving = false;
    private string alertMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadVaultItems();
    }

    private async Task LoadVaultItems()
    {
        isLoading = true;
        vaultItems = await ApiService.GetMyVaultItemsAsync();
        isLoading = false;
    }

    private async Task HandleCreateItem()
    {
        if (string.IsNullOrWhiteSpace(newItem.Title) || string.IsNullOrWhiteSpace(newItem.Password))
            return;

        isSaving = true;
        var created = await ApiService.CreateVaultItemAsync(newItem);
        if (created != null)
        {
            newItem = new CreateVaultItemDto();
            await LoadVaultItems();
        }
        isSaving = false;
    }

    private async Task DecryptItem(Guid id)
    {
        var decrypted = await ApiService.DecryptVaultItemAsync(id);
        if (decrypted != null && !string.IsNullOrEmpty(decrypted.DecryptedPassword))
        {
            decryptedSecrets[id] = decrypted.DecryptedPassword;
        }
    }

    private async Task ExportEncryptedBackup()
    {
        // Generar JSON del respaldo para cumplir la Garantía de Disponibilidad (G1 CUN)
        var jsonContent = System.Text.Json.JsonSerializer.Serialize(vaultItems);
        var fileName = $"CryptoVault_Backup_{DateTime.Now:yyyyMMdd_HHmmss}.json";

        // Descarga directa a través de Interop de JavaScript
        var fileBytes = System.Text.Encoding.UTF8.GetBytes(jsonContent);
        var base64Data = Convert.ToBase64String(fileBytes);
        var fileUrl = $"data:text/json;charset=utf-8;base64,{base64Data}";

        await JSRuntime.InvokeVoidAsync("eval", $"let a = document.createElement('a'); a.href = '{fileUrl}'; a.download = '{fileName}'; a.click();");

        alertMessage = " Respaldo de seguridad exportado exitosamente. Garantía de Disponibilidad (G1 CIA) verificada.";
    }

    private void Logout()
    {
        ApiService.ClearAuthToken();
        NavigationManager.NavigateTo("/login");
    }
}